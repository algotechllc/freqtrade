{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 0,
  "stake_currency": "USDC",
  "stake_amount": 50,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 5000,
  "cancel_open_orders_on_exit": false,
  "timeframe": "5m",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "limit",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "hyperliquid",
    "key": "",
    "secret": "",
    "walletAddress": "",
    "privateKey": "",
    "enable_ws": false,
    "ccxt_config": {
      "options": {
        "defaultType": "swap"
      }
    },
    "ccxt_async_config": {
      "options": {
        "defaultType": "swap"
      }
    },
    "pair_whitelist": ["XRP/USDC:USDC"],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "jwt_secret_key": "local-dev-jwt-secret-change-before-server-deploy",
    "ws_token": "local-dev-ws-token-change-before-server-deploy",
    "username": "freqtrader",
    "password": "SuperSecurePassword"
  },
  "bot_name": "freqtrade-spot-ladder-hyperliquid",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 300
  },
  "add_config_files": ["config-private.json"]
}
